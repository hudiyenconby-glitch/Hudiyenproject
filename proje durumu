<script>document.documentElement.className="js";try{if(sessionStorage.getItem("hdy"))document.documentElement.className+=" seen";else sessionStorage.setItem("hdy","1")}catch(e){}</script>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,500&family=Schibsted+Grotesk:wght@400;600;800&display=swap" rel="stylesheet">
<style>
/* ===== LOGO YAZI TİPİ: 'CheckFor' dosyanız varsa buraya @font-face ekleyin:
@font-face{font-family:'CheckFor';src:url('BURAYA-FONT-DOSYASI-URL.woff2') format('woff2');font-display:swap}
*/
:root{--bg:#f4f0e9;--panel:#fbf9f5;--ink:#1c1b18;--mute:#7a7467;--line:#ddd5c7;--acc:#2f4a3a;--acc2:#e3e8df;--ok:#2f7a4f;--wait:#9a958b;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#141310;--panel:#1d1b17;--ink:#efe9dd;--mute:#9b9384;--line:#34312a;--acc:#9bbf9f;--acc2:#2a3a2f;--ok:#7ccf98;--wait:#6b665b}}
:root[data-theme="dark"]{--bg:#141310;--panel:#1d1b17;--ink:#efe9dd;--mute:#9b9384;--line:#34312a;--acc:#9bbf9f;--acc2:#2a3a2f;--ok:#7ccf98;--wait:#6b665b}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Schibsted Grotesk',system-ui,'Segoe UI',sans-serif;line-height:1.5}
.wrap{max-width:980px;margin:0 auto;padding:28px 18px 60px}
h1{font-size:clamp(26px,5vw,40px);font-weight:800;letter-spacing:-.02em;margin:0 0 6px}
.sub{color:var(--mute);margin:0 0 22px;max-width:56ch}
.search{display:flex;gap:10px;flex-wrap:wrap;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px;align-items:end}
.f{display:flex;flex-direction:column;gap:4px;flex:1 1 120px}
label{font-size:13px;color:var(--mute);font-weight:600}
input{font:inherit;font-size:18px;padding:10px 12px;border:1.5px solid var(--line);border-radius:9px;background:var(--bg);color:var(--ink);width:100%}
input:focus,button:focus-visible{outline:3px solid var(--acc);outline-offset:1px;border-color:var(--acc)}
button.go{font:inherit;font-weight:700;background:var(--acc);color:var(--bg);border:0;border-radius:9px;padding:12px 26px;cursor:pointer;min-height:46px}
button.go:active{transform:scale(.97)}
.msg{margin:16px 2px;color:var(--mute)}
.msg.err{color:#c8372d;font-weight:600}
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0 0}
.tab{font:inherit;border:1.5px solid var(--line);background:var(--panel);color:var(--ink);padding:8px 14px;border-radius:999px;cursor:pointer}
.tab[aria-selected=true]{background:var(--acc);border-color:var(--acc);color:var(--bg)}
.card{background:var(--panel);border:1px solid var(--line);border-radius:14px;margin-top:16px;padding:22px;display:none}
.card.on{display:block;animation:in .5s ease}
@keyframes in{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.head{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:18px}
.head b{font-size:20px}.head span{color:var(--mute);font-size:14px}
.grid{display:grid;grid-template-columns:240px 1fr;gap:26px;align-items:center}
@media(max-width:720px){.grid{grid-template-columns:1fr}}
.left{display:flex;gap:18px;align-items:center;justify-content:center}
.donut{position:relative;width:190px;height:190px;flex:none}
.donut svg{transform:rotate(-90deg)}
.donut .c{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
.donut .c strong{font-size:40px;font-weight:800;line-height:1}
.donut .c small{color:var(--mute);font-size:13px}
.leg{display:flex;gap:16px;justify-content:center;margin-top:10px;font-size:13px;color:var(--mute)}
.leg i{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:5px}
.bld{width:64px;flex:none}
.stage{display:grid;grid-template-columns:1fr auto;gap:2px 10px;padding:11px 0;border-top:1px solid var(--line)}
.stage:first-child{border-top:0}
.stage .n{font-weight:600}
.stage .p{font-variant-numeric:tabular-nums;font-weight:700}
.bar{grid-column:1/3;height:8px;background:var(--acc2);border-radius:99px;overflow:hidden}
.bar>div{height:100%;width:0;border-radius:99px;background:var(--acc);transition:width 1.1s cubic-bezier(.2,.8,.2,1)}
.stage.done .bar>div{background:var(--ok)}
.tag{font-size:12px;color:var(--mute);grid-column:1/3}
.stage.now .tag{color:var(--acc);font-weight:600}
.stage.done .tag{color:var(--ok)}
.pulse{animation:pl 1.6s ease-in-out infinite}
@keyframes pl{50%{opacity:.55}}
.foot{margin-top:20px;color:var(--mute);font-size:13px}
h1,.head b,.donut .c strong{font-family:'Playfair Display','Iowan Old Style','Palatino Linotype',Georgia,serif}
h1{font-weight:700;letter-spacing:0;font-size:clamp(26px,5vw,38px)}
.head b{font-weight:700;font-size:22px}
.donut .c strong{font-weight:700;font-variant-numeric:lining-nums}
.files{grid-column:1/3;display:flex;flex-wrap:wrap;gap:8px;margin-top:6px;animation:fade .6s .9s both}
.fdl{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:var(--acc);text-decoration:none;border:1.5px solid var(--line);border-radius:999px;padding:5px 12px;background:var(--bg)}
.fdl:hover{border-color:var(--acc);background:var(--acc2)}
.fdl:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
.cv{position:fixed;inset:0;z-index:90;background:#1c1b18;transform:translateY(100%);transition:transform .6s cubic-bezier(.7,0,.2,1);pointer-events:none}.cv.on{transform:none}
.stage{animation:rise .6s cubic-bezier(.2,.8,.2,1) both;animation-delay:calc(.3s + var(--k,0)*.09s)}
.ld{display:inline-block;width:90px;height:4px;border-radius:9px;background:var(--acc2);overflow:hidden;vertical-align:middle;margin-right:10px}
.ld i{display:block;height:100%;width:40%;background:var(--acc);border-radius:9px;animation:ldm .8s ease-in-out infinite alternate}
@keyframes ldm{to{transform:translateX(150%)}}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
:root{--ff-logo:'CheckFor','Playfair Display','Iowan Old Style',Georgia,serif;--l1:var(--ink);--l2:var(--mute)}
/* preloader */
.pre{position:fixed;inset:0;z-index:100;background:#1c1b18;color:#f4f0e9;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:28px;animation:lift 1s cubic-bezier(.7,0,.2,1) 3.2s both}
.seen .pre{display:none}
@keyframes lift{to{transform:translateY(-100%);visibility:hidden}}
.pl-logo{width:min(34vw,160px);height:auto}
.pl-logo circle,.pl-logo line{fill:none;stroke:#f4f0e9}
.pl-logo .r2,.pl-logo .b2{stroke:#9a958b}
.pl-logo .b{stroke-width:49.5}
.pl-logo circle{stroke-dasharray:1;stroke-dashoffset:0;animation:draw 1.4s cubic-bezier(.6,0,.2,1) both}
.pl-logo .r2{animation-delay:.15s}.pl-logo .r3{animation-delay:.3s}
.pl-logo .b{animation:slide 1.1s cubic-bezier(.2,.8,.2,1) both}
.pl-logo .b1{animation-delay:.7s}.pl-logo .b2{animation-delay:.85s}.pl-logo .b3{animation-delay:1s}
.plw{font-family:var(--ff-logo);font-size:clamp(30px,8vw,54px);font-weight:700;letter-spacing:.32em;padding-left:.32em;line-height:1}
.plw span{display:inline-block;animation:rise .6s cubic-bezier(.2,.8,.2,1) both;animation-delay:calc(1.5s + var(--i)*.07s)}
.pltag{font-family:'Playfair Display',Georgia,serif;font-style:italic;color:#bdb6a8;animation:fade .8s 2.2s both}
@keyframes draw{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}
@keyframes slide{from{transform:translate(-460px,460px);opacity:0}to{transform:none;opacity:1}}
@keyframes rise{from{opacity:0;transform:translateY(.5em)}to{opacity:1;transform:none}}
@keyframes fade{from{opacity:0}to{opacity:1}}
/* header */
.hd{position:fixed;top:0;left:0;right:0;z-index:50;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:calc(14px + env(safe-area-inset-top,0px)) 24px 14px;background:color-mix(in srgb,var(--bg) 84%,transparent);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid transparent;transition:border-color .3s}
.hd.sc{border-bottom-color:var(--line)}
.hd-logo{display:flex;align-items:center;gap:12px;text-decoration:none}
.hd-logo svg{width:36px;height:36px}
.hd-logo b{font-family:var(--ff-logo);font-size:19px;letter-spacing:.3em;font-weight:700}
.hd nav{display:flex;align-items:center;gap:26px}
.hd nav a{text-decoration:none;font-size:14px;font-weight:600;color:var(--mute);transition:color .2s}
.hd nav a:hover{color:var(--ink)}
.hd nav a.cur{color:var(--ink)}
.pill{display:inline-flex;align-items:center;gap:8px;border:1.5px solid var(--ink);border-radius:999px;padding:9px 18px;font-size:14px;font-weight:700;text-decoration:none;color:var(--ink);background:transparent;transition:background .25s,color .25s}
.pill:hover{background:var(--ink);color:var(--bg)}
.pill:focus-visible,.hd a:focus-visible{outline:3px solid var(--acc);outline-offset:3px}
.hd nav .pill{color:var(--ink)}.hd nav .pill:hover{color:var(--bg)}
@media(max-width:820px){.hd nav a:not(.pill){display:none}.hd{padding-left:16px;padding-right:16px}.hd-logo b{font-size:16px}}

.wrap{padding-top:112px}
@media (prefers-reduced-motion:reduce){.pre{display:none}}
</style>
</head>
<body>
<div class="cv" id="cv"></div>
<div class="pre" aria-hidden="true">
  <svg class="pl-logo" viewBox="0 0 1080 1080"><defs><clipPath id="cp"><rect width="1080" height="1080"/></clipPath></defs>
  <g clip-path="url(#cp)"><g transform="rotate(-90 540 540)">
    <circle class="r1" cx="540" cy="540" r="277" stroke-width="26" pathLength="1"/>
    <circle class="r2" cx="540" cy="540" r="252" stroke-width="24" pathLength="1"/>
    <circle class="r3" cx="540" cy="540" r="240" stroke-width="3" pathLength="1"/></g>
    <line class="b b1" x1="-150" y1="1083" x2="868.5" y2="64.5"/>
    <line class="b b2" x1="105.5" y1="974.5" x2="974.5" y2="105.5"/>
    <line class="b b3" x1="211" y1="1037.5" x2="1200" y2="48.5"/></g></svg>
  <div class="plw"><span style="--i:0">H</span><span style="--i:1">U</span><span style="--i:2">D</span><span style="--i:3">İ</span><span style="--i:4">Y</span><span style="--i:5">E</span><span style="--i:6">N</span></div>
  <div class="pltag">Mimarlık Ofisi</div>
</div>

<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <symbol id="mk" viewBox="0 0 1080 1080"><clipPath id="cq"><rect width="1080" height="1080"/></clipPath>
  <g clip-path="url(#cq)" fill="none"><circle cx="540" cy="540" r="277" stroke="var(--l1)" stroke-width="26"/><circle cx="540" cy="540" r="252" stroke="var(--l2)" stroke-width="24"/><circle cx="540" cy="540" r="240" stroke="var(--l1)" stroke-width="3"/>
  <line x1="-150" y1="1083" x2="868.5" y2="64.5" stroke="var(--l1)" stroke-width="49.5"/><line x1="105.5" y1="974.5" x2="974.5" y2="105.5" stroke="var(--l2)" stroke-width="49.5"/><line x1="211" y1="1037.5" x2="1200" y2="48.5" stroke="var(--l1)" stroke-width="49.5"/></g></symbol>
</defs></svg>

<header class="hd" id="hd">
  <a class="hd-logo" data-url="portfolyo" target="_top" href="hudiyen-portfolyo.html" aria-label="HUDİYEN ana sayfa"><svg aria-hidden="true"><use href="#mk"/></svg><b>HUDİYEN</b></a>
  <nav>
    <a data-url="portfolyo" target="_top" href="hudiyen-portfolyo.html">Çalışmalarımız</a>
    <a class="pill" href="#top" aria-current="page">Proje Durumu Sorgula</a>
  </nav>
</header>
<div class="wrap">
  <h1>Projenizin durumunu görün</h1>
  <p class="sub">Ada ve parsel numaranızı yazın; projenizin hangi aşamada olduğunu ve kalan işi burada görün.</p>

  <form class="search" id="frm" onsubmit="return false">
    <div class="f"><label for="ada">Ada</label><input id="ada" inputmode="numeric" autocomplete="off" placeholder="örn. 1204"></div>
    <div class="f"><label for="parsel">Parsel</label><input id="parsel" inputmode="numeric" autocomplete="off" placeholder="örn. 7"></div>
    <button class="go" id="btn" type="submit">Sorgula</button>
  </form>

  <div class="msg" id="msg" aria-live="polite"></div>
  <div class="tabs" id="tabs" role="tablist"></div>
  <div class="card" id="card"></div>
</div>

<script>
/* ====== VERİLERİ BURADAN DÜZENLEYİN ======
   stages: 7 aşamanın her biri için % ilerleme (0-100), sırasıyla STAGES ile eşleşir.
   dosya: aşama numarası (0'dan başlar) → indirilecek dosyaların {ad, url} listesi.
   Dosyaları Drive/OneDrive gibi bir yerde paylaşıp bağlantıyı url'ye yazın. */
var STAGES=[
 {n:"Etüt ve ön görüşme",w:10},
 {n:"Avan proje",w:15},
 {n:"Ruhsat projesi",w:15},
 {n:"Statik inceleme",w:15},
 {n:"Uygulama projesi",w:25},
 {n:"Metraj ve keşif",w:12},
 {n:"Teslim ve arşiv",w:8}
];
var PROJECTS=[
 {ada:"1204",parsel:"7",musteri:"Örnek Müşteri A",proje:"5 katlı konut",yer:"Edirne, Merkez",stages:[100,100,70,0,0,0,0],guncel:"12.10.2026"},
 {ada:"604",parsel:"44",musteri:"Örnek Müşteri D",proje:"Konut projesi",yer:"Edirne, Merkez",stages:[100,100,100,60,0,0,0],guncel:"12.10.2026",
  dosya:{0:[{ad:"Etüt raporu (PDF)",url:"https://example.com/ornek-etut.pdf"}],1:[{ad:"Avan proje paftaları (PDF)",url:"https://example.com/ornek-avan.pdf"}],2:[{ad:"Ruhsat projesi (PDF)",url:"https://example.com/ornek-ruhsat.pdf"},{ad:"Mimari plan (DWG)",url:"https://example.com/ornek-plan.dwg"}]}},
 {ada:"1204",parsel:"7",musteri:"Örnek Müşteri A",proje:"Bahçe peyzaj projesi",yer:"Edirne, Merkez",stages:[100,40,0,0,0,0,0],guncel:"08.10.2026"},
 {ada:"350",parsel:"12",musteri:"Örnek Müşteri B",proje:"Öğrenci yurdu iç mekân",yer:"Edirne, Karaağaç",stages:[100,100,100,100,100,55,0],guncel:"10.10.2026"},
 {ada:"88",parsel:"3",musteri:"Örnek Müşteri C",proje:"Ofis tadilatı",yer:"Edirne, Merkez",stages:[100,100,100,100,100,100,100],guncel:"01.10.2026"}
];
/* ========================================= */

var URLS={portfolyo:"hudiyen-portfolyo.html"};   /* Wix'te TAM adres yazın: "https://www.siteniz.com/calismalar" (kısa "/calismalar" embed içinde ÇALIŞMAZ) */
var $=function(i){return document.getElementById(i)};
document.querySelectorAll("[data-url]").forEach(function(a){a.href=URLS[a.dataset.url];a.addEventListener("click",function(e){
  if(e.ctrlKey||e.metaKey||e.shiftKey)return;e.preventDefault();$("cv").classList.add("on");
  setTimeout(function(){try{window.open(a.href,"_top")}catch(x){location.href=a.href}setTimeout(function(){$("cv").classList.remove("on")},1500)},620)})});
var cur=[];

function files(p,k){var L=(p.dosya||{})[k]||[];if(!L.length)return"";return '<div class="files">'+L.map(function(f){return '<a class="fdl" href="'+f.url+'" target="_blank" rel="noopener noreferrer"><svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v8m0 0L4.5 6.5M8 10l3.5-3.5M3 13h10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>'+f.ad+'</a>'}).join("")+'</div>'}
function total(p){var t=0;STAGES.forEach(function(s,i){t+=s.w*(p.stages[i]||0)/100});return Math.round(t)}

function render(i){
  var p=cur[i],pct=total(p),rest=100-pct,R=78,C=2*Math.PI*R;
  var firstOpen=p.stages.findIndex(function(v){return v<100});
  var st=STAGES.map(function(s,k){
    var v=p.stages[k]||0,cls=v>=100?"done":(k===firstOpen?"now":"");
    var tag=v>=100?"Tamamlandı":(k===firstOpen?"Devam ediyor":"Sırada");
    return '<div class="stage '+cls+'" style="--k:'+k+'"><span class="n">'+s.n+'</span><span class="p" data-to="'+v+'">0%</span><div class="bar"><div data-w="'+v+'"></div></div><span class="tag'+(cls==="now"?" pulse":"")+'">'+tag+'</span>'+files(p,k)+'</div>';
  }).join("");
  var floors="";for(var f=0;f<10;f++){floors+='<rect class="fl" data-i="'+f+'" x="6" y="'+(8+f*14)+'" width="52" height="11" rx="2" fill="var(--acc2)"/>';}
  var card=$("card");
  card.innerHTML=
   '<div class="head"><div><b>'+p.proje+'</b><br><span>'+p.musteri+' · Ada '+p.ada+' / Parsel '+p.parsel+' · '+p.yer+'</span></div><span>Son güncelleme: '+p.guncel+'</span></div>'+
   '<div class="grid"><div><div class="left"><div class="donut"><svg width="190" height="190" viewBox="0 0 190 190" role="img" aria-label="Tamamlanan %'+pct+', kalan %'+rest+'">'+
   '<circle cx="95" cy="95" r="'+R+'" fill="none" stroke="var(--acc2)" stroke-width="20"/>'+
   '<circle id="arc" cx="95" cy="95" r="'+R+'" fill="none" stroke="var(--acc)" stroke-width="20" stroke-linecap="round" stroke-dasharray="'+C+'" stroke-dashoffset="'+C+'" style="transition:stroke-dashoffset 1.4s cubic-bezier(.2,.8,.2,1)"/></svg>'+
   '<div class="c"><strong id="big">0%</strong><small>tamamlandı</small></div></div>'+
   '<svg class="bld" viewBox="0 0 64 156" aria-hidden="true">'+floors+'</svg></div>'+
   '<div class="leg"><span><i style="background:var(--acc)"></i>Biten %'+pct+'</span><span><i style="background:var(--acc2)"></i>Kalan %'+rest+'</span></div></div>'+
   '<div>'+st+'</div></div>'+
   '<div class="foot">Yüzde, aşamaların iş yüküne göre ağırlıklandırılarak hesaplanır.</div>';
  card.classList.remove("on");void card.offsetWidth;card.classList.add("on");
  var arc=$("arc");
  requestAnimationFrame(function(){requestAnimationFrame(function(){
    arc.style.strokeDashoffset=C*(1-pct/100);
    card.querySelectorAll(".bar>div").forEach(function(b,k){setTimeout(function(){b.style.width=b.dataset.w+"%"},120*k)});
    count($("big"),pct);
    card.querySelectorAll(".p").forEach(function(e){count(e,+e.dataset.to)});
    var lit=Math.round(pct/10);
    card.querySelectorAll(".fl").forEach(function(r){var n=+r.dataset.i;if(9-n<lit){setTimeout(function(){r.style.transition="fill .4s";r.setAttribute("fill","var(--acc)")},150*(lit-(9-n))+200)}});
  })});
  document.querySelectorAll(".tab").forEach(function(t,k){t.setAttribute("aria-selected",k===i)});
}
function count(el,to){
  var t0=null,d=1300;
  function s(t){if(!t0)t0=t;var k=Math.min((t-t0)/d,1),e=1-Math.pow(1-k,3);el.textContent=Math.round(to*e)+"%";if(k<1)requestAnimationFrame(s)}
  requestAnimationFrame(s);
}
function search(){var m=$("msg");$("tabs").innerHTML="";$("card").classList.remove("on");$("card").innerHTML="";m.className="msg";m.innerHTML='<span class="ld"><i></i></span>Kayıtlar aranıyor…';setTimeout(doSearch,850)}
function doSearch(){
  var a=$("ada").value.trim(),p=$("parsel").value.trim(),m=$("msg");
  $("tabs").innerHTML="";$("card").classList.remove("on");$("card").innerHTML="";
  if(!a||!p){m.className="msg err";m.textContent="Ada ve parsel numarasını birlikte yazın.";return}
  cur=PROJECTS.filter(function(x){return x.ada===a&&x.parsel===p});
  if(!cur.length){m.className="msg err";m.textContent="Ada "+a+" / Parsel "+p+" için kayıtlı proje bulunamadı. Numaraları kontrol edin veya ofisimizle iletişime geçin.";return}
  m.className="msg";m.textContent=cur.length>1?cur.length+" proje bulundu. Görmek istediğinizi seçin.":"";
  if(cur.length>1){$("tabs").innerHTML=cur.map(function(c,i){return '<button class="tab" role="tab" data-i="'+i+'">'+c.proje+'</button>'}).join("");
    document.querySelectorAll(".tab").forEach(function(t){t.onclick=function(){render(+t.dataset.i)}})}
  render(0);
}
$("btn").onclick=search;
["ada","parsel"].forEach(function(id){$(id).addEventListener("keydown",function(e){if(e.key==="Enter")search()})});

/* güvenlik: perde takılırsa kaldır */
setTimeout(function(){var p=document.querySelector(".pre");if(p)p.style.display="none"},4800);
</script>
</body>
</html>
